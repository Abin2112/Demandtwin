# Generate a private 32+ character secret for any shared deployment.
# Native local development creates a private secret under data/runtime.
# JWT_SECRET=
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://demandtwin:local-dev-password@127.0.0.1:5432/demandtwin
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# SECURE_COOKIES=1
# RESEARCH_REGISTRATION_CODE=
# ETHICS_PROTOCOL_ID=
# ETHICS_CONSENT_TEXT=
# API_ORIGIN=http://127.0.0.1:8000
# DEMANDTWIN_API_PORT=8000
# DEMANDTWIN_WEB_PORT=3000
# OFF_USER_AGENT=DemandTwin/0.1 (project URL or contact)
